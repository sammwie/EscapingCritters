text = "You keep looking at me like you want to leave."

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("2_line")
speaker = "Butcher"
text = "Nobody leaves. I checked the roads. Twice."

[sub_resource type="Resource" id="Resource_3"]
