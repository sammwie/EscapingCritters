[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_line")
speaker = "Butcher"
text = "Don't touch the display. Look, don't touch."

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("2_line")
speaker = "Butcher"
text = "Best cuts in town. Ask anyone. Go on, ask."

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("2_line")
speaker = "Butcher"
text = "Someone moved my knives. I never move my knives."
min_corruption = 2

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("2_line")
speaker = "Butcher"
text = "Everyone here says the same things. Have you noticed?"
min_corruption = 3
glitch = true

[sub_resource type="Resource" id="Resource_5"]
script = ExtResource("2_line")
speaker = "Butcher"
text = "Still here? Buy something or move along."

[sub_resource type="Resource" id="Resource_6"]
script = ExtResource("2_line")
speaker = "Butcher"
text = "I told you this already. Didn't I tell you this already?"
min_corruption = 2

[sub_resource type="Resource" id="Resource_7"]
script = ExtResource("2_line")
speaker = "Butcher"
text = "Look, don't touch. Look, don't touch. Look, don't touch."
min_corruption = 3
glitch = true

