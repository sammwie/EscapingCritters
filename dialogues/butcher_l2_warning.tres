[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" uid="uid://bilm6gbrl1knw" path="res://scripts/dialogue_data.gd" id="1_data"]
[ext_resource type="Script" uid="uid://cuib8na2qq78n" path="res://scripts/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_line")
speaker = "Butcher"
text = "You're up early. Everyone's up early. Did I open the shop already?"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("2_line")
speaker = "Butcher"
text = "Eggs, hm? Crack one for me. Go on. I want to see the inside."

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("2_line")
speaker = "Butcher"
text = "Nothing in there. Nothing, nothing. Funny, isn't it?"

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("2_line")
speaker = "Butcher"
text = "The knives are very sharp today."

[sub_resource type="Resource" id="Resource_5"]
script = ExtResource("2_line")
speaker = "Butcher"
text = "Don't wander far. I like knowing where you are."

[resource]
script = ExtResource("1_data")
npc_id = "butcher_l2"
lines = Array[ExtResource("2_line")]([SubResource("Resource_1"), SubResource("Resource_2"), SubResource("Resource_3")])
repeat_lines = Array[ExtResource("2_line")]([SubResource("Resource_4"), SubResource("Resource_5")])
