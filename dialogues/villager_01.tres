[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_line")
speaker = "Villager"
text = "Oh, hello! Isn't it a lovely day?"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("2_line")
speaker = "Villager"
text = "It's always a lovely day here. That's what I like about it."

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("2_line")
speaker = "Villager"
text = "Have you ever seen the sun go down? I don't think I have."
min_corruption = 2

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("2_line")
speaker = "Villager"
text = "Every path leads back to the square. Every path. Every path."
